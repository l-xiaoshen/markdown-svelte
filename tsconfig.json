{
	"extends": "$app/tsconfig",
	"include": ["src", "vite.config.ts"],
	"compilerOptions": {
		// Type-check the documentation examples against source before packaging.
		"paths": {
			"markdown-svelte": ["./src/lib/index.ts"],
			"markdown-svelte/stream": ["./src/lib/stream/index.ts"]
		},
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"strict": true
	}
}
