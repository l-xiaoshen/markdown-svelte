{
	"name": "markdown-svelte",
	"version": "0.0.5",
	"description": "A secure, typed Markdown renderer for Svelte 5.",
	"license": "MIT",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"test": "vitest run src",
		"test:watch": "vitest src",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"src/lib",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./stream": {
			"types": "./dist/stream/index.d.ts",
			"svelte": "./dist/stream/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.57.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.24",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	},
	"keywords": [
		"svelte",
		"markdown",
		"markdown-renderer",
		"svelte-component"
	],
	"dependencies": {
		"stream-markdown-parser": "^1.2.17"
	}
}
